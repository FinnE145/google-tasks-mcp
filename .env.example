# Auth Layer A — Google OAuth client for MCP connector authentication
# Create a "Web application" OAuth 2.0 client at console.cloud.google.com
# Redirect URI to register there: https://google-tasks.fmje.dev/auth/callback
LAYER_A_CLIENT_ID=your-layer-a-client-id.apps.googleusercontent.com
LAYER_A_CLIENT_SECRET=your-layer-a-client-secret

# Auth Layer B — Google OAuth client for Tasks API access
# Create a "Desktop app" OAuth 2.0 client at console.cloud.google.com
# Run: python scripts/bootstrap_tasks_token.py  (once, opens a browser)
LAYER_B_CLIENT_SECRETS_FILE=/home/finne/Projects/google-tasks-mcp/layer_b_client_secrets.json
TASKS_TOKEN_FILE=/home/finne/Projects/google-tasks-mcp/token.json

# Server config
PORT=45690
BASE_URL=https://google-tasks.fmje.dev

# Email allowlist — only this address can authenticate via the connector
# Comma-separated for multiple; must not be empty (empty = no one allowed)
ALLOWED_EMAILS=finne014@gmail.com
